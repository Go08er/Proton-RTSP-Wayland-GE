From a0b489b6f64219c27cd6581ce53703c90f8c985e Mon Sep 17 00:00:00 2001
From: Go08er <149829787+Go08er@users.noreply.github.com>
Date: Sat, 25 Jul 2026 11:02:54 -0500
Subject: [PATCH] proton: Prepare the GE-Proton11-3 Beta 1 launcher

Advance the prefix identity and adapt GE-Proton11-3 native-Wayland Steam Input suppression to the RTSP launcher. Force Steam Input off for WineWayland, select the game AppID while it runs, and restore Steam global input routing afterward.
---
 proton | 50 +++++++++++++++++++++++++++++++++++++++++++++-----
 1 file changed, 45 insertions(+), 5 deletions(-)

diff --git a/proton b/proton
index c3d73f239afd8555af55c75576b26070130b36d4..c6bb23c06587196b8594fdd0d7c97107f0b8ce9c 100755
--- a/proton
+++ b/proton
@@ -45,7 +45,7 @@ from random import randrange
 #To enable debug logging, copy "user_settings.sample.py" to "user_settings.py"
 #and edit it if needed.
 
-CURRENT_PREFIX_VERSION="11.0-102"
+CURRENT_PREFIX_VERSION="11.0-103"
 
 PFX="Proton: "
 ld_path_var = "LD_LIBRARY_PATH"
@@ -1450,6 +1450,7 @@ class Session:
     def __init__(self):
         self.log_file = None
         self.env = dict(os.environ)
+        self.force_steam_input_appid = False
         self.dlloverrides = {
                 "steam.exe": "b", #always use our special built-in steam.exe
                 "dotnetfx35.exe": "b", #replace the broken installer, as does Windows
@@ -1936,10 +1937,13 @@ class Session:
             self.env["WINE_DISABLE_FULLSCREEN_HACK"] = "1"
             self.env.setdefault("WINE_MOVE_HACK", "1")
             self.env["PROTON_USE_XALIA"] = "0"
-            self.env.setdefault("PROTON_NO_STEAMINPUT", "1")
+            # Never expose Steam's desktop virtual controller on WineWayland.
+            self.env["PROTON_NO_STEAMINPUT"] = "1"
+            # Steam cannot track native Wayland window focus, so keep it from
+            # falling back to the global desktop controller layout.
+            self.force_steam_input_appid = True
             if nonzero(self.env["PROTON_NO_STEAMINPUT"]):
-                # Keep controller state coherent when Steam Input is disabled
-                # explicitly as well as when Wayland selects the default.
+                # Remove launcher metadata for the disabled virtual controller.
                 if "SDL_GAMECONTROLLER_IGNORE_DEVICES" in self.env:
                     del self.env["SDL_GAMECONTROLLER_IGNORE_DEVICES"]
                 if "SteamVirtualGamepadInfo" in self.env:
@@ -2084,6 +2088,32 @@ class Session:
             local_env = self.env
         return subprocess.call(args, env=local_env, stderr=self.log_file, stdout=self.log_file)
 
+    def set_steam_input_appid(self, appid):
+        steam_bin = shutil.which("steam")
+        if not steam_bin:
+            log("Unable to set Steam Input AppID: steam executable not found.")
+            return False
+
+        env = dict(os.environ)
+        for name in ("SteamAppId", "SteamGameId", "STEAM_COMPAT_APP_ID"):
+            env.pop(name, None)
+
+        try:
+            result = subprocess.run(
+                [steam_bin, "steam://forceinputappid/" + str(appid)],
+                env=env,
+                stdin=subprocess.DEVNULL,
+                stdout=subprocess.DEVNULL,
+                stderr=subprocess.DEVNULL,
+                timeout=5,
+                check=False,
+            )
+        except (OSError, subprocess.TimeoutExpired) as error:
+            log("Unable to set Steam Input AppID: " + str(error))
+            return False
+
+        return result.returncode == 0
+
     def run(self):
         if shutil.which('steam-runtime-launcher-interface-0') is not None:
             adverb = ['steam-runtime-launcher-interface-0', 'proton']
@@ -2114,7 +2144,17 @@ class Session:
             else:
                 argv = [g_proton.wine_bin, "c:\\windows\\system32\\steam.exe"]
 
-        rc = self.run_proc(adverb + argv + sys.argv[2:] + self.cmdlineappend)
+        steam_input_appid_forced = False
+        if self.force_steam_input_appid:
+            appid = os.environ.get("SteamGameId", os.environ.get("STEAM_COMPAT_APP_ID", "0"))
+            if str(appid).isdigit() and str(appid) != "0":
+                steam_input_appid_forced = self.set_steam_input_appid(appid)
+
+        try:
+            rc = self.run_proc(adverb + argv + sys.argv[2:] + self.cmdlineappend)
+        finally:
+            if steam_input_appid_forced:
+                self.set_steam_input_appid(0)
 
         if remote_debug_proc:
             remote_debug_proc.kill()
