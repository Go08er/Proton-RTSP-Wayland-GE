diff --git a/Makefile.in b/Makefile.in
--- a/Makefile.in
+++ b/Makefile.in
@@ -413,6 +413,12 @@ $(eval $(call rules-cargo,gst_plugins_rs,i386,unix))
 $(eval $(call rules-cargo,gst_plugins_rs,x86_64,unix))
 $(eval $(call rules-cargo,gst_plugins_rs,aarch64,unix))
 
+GST_PLUGINS_RS_RUSTFLAGS = --remap-path-prefix=$(CARGO_HOME)=/usr/src/cargo
+GST_PLUGINS_RS_i386_ENV += RUSTFLAGS="$(GST_PLUGINS_RS_RUSTFLAGS)"
+GST_PLUGINS_RS_x86_64_ENV += RUSTFLAGS="$(GST_PLUGINS_RS_RUSTFLAGS)"
+GST_PLUGINS_RS_aarch64_ENV += RUSTFLAGS="$(GST_PLUGINS_RS_RUSTFLAGS)"
+
+
 $(OBJ)/.gst_plugins_rs-x86_64-post-build:
 	mkdir -p $(GST_PLUGINS_RS_x86_64_DST)/lib/x86_64-linux-gnu/gstreamer-1.0/
 	cp -a $(GST_PLUGINS_RS_x86_64_OBJ)/x86_64-unknown-linux-gnu/release/libgstdav1d.so $(GST_PLUGINS_RS_x86_64_DST)/lib/x86_64-linux-gnu/gstreamer-1.0/

