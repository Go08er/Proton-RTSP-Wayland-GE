+##
+## X11 locale data used by Wine Wayland/xkbcommon Compose handling
+##
+
+X11_LOCALE_DIR := $(DST_DIR)/share/X11/
+
+$(OBJ)/.x11-locale-dist: $(SRC)/locale
+	rm -rf $(X11_LOCALE_DIR)/
+	mkdir -p $(X11_LOCALE_DIR)
+	cp -R $< $(X11_LOCALE_DIR)
+	touch $@
+
+all-dist: $(OBJ)/.x11-locale-dist
+
+
+##
+## xrandr used by the Wayland primary-monitor selection helper
+##
+
+XRANDR_VER := 1.5.4
+XRANDR_TARBALL := xrandr-$(XRANDR_VER).tar.xz
+XRANDR_TARBALL_URL := https://www.x.org/releases/individual/app/$(XRANDR_TARBALL)
+XRANDR_SHA256 := 2cafccb2aaf2491a4068676117a0d4f90ab307724b96fffc54cd1da953779400
+XRANDR_SRC := $(OBJ)/src-xrandr
+XRANDR_ARCH := $(if $(filter arm64,$(TARGET_ARCH)),aarch64,x86_64)
+XRANDR_OBJ := $(OBJ)/obj-xrandr-$(XRANDR_ARCH)
+XRANDR_DST := $(OBJ)/dst-xrandr-$(XRANDR_ARCH)
+XRANDR_BINDIR := $(if $(filter arm64,$(TARGET_ARCH)),$(DST_DIR)/bin-arm64,$(DST_DIR)/bin)
+XRANDR_ENV = \
+	CC="$($(XRANDR_ARCH)-unix_TARGET)-gcc" \
+	PKG_CONFIG="$($(XRANDR_ARCH)-unix_TARGET)-pkg-config" \
+	PKG_CONFIG_LIBDIR="/usr/lib/$($(XRANDR_ARCH)-unix_LIBDIR)/pkgconfig:/usr/share/pkgconfig" \
+	CFLAGS="$($(XRANDR_ARCH)_CFLAGS) $(CFLAGS)" \
+	LDFLAGS="$($(XRANDR_ARCH)_LDFLAGS) $(LDFLAGS)"
+XRANDR_DIST := $(XRANDR_BINDIR)/xrandr
+
+$(SRC)/contrib/$(XRANDR_TARBALL):
+	mkdir -p $(SRC)/contrib
+	wget --no-use-server-timestamps -O $@ $(XRANDR_TARBALL_URL) || (rm $@; false)
+
+$(OBJ)/.xrandr-source: $(SRC)/contrib/$(XRANDR_TARBALL)
+	printf '%s  %s\n' '$(XRANDR_SHA256)' '$<' | sha256sum -c -
+	rm -rf $(XRANDR_SRC)
+	mkdir -p $(XRANDR_SRC)
+	tar --no-same-owner --strip-components=1 -xf $< -C $(XRANDR_SRC)
+	touch $@
+
+$(OBJ)/.xrandr-configure $(OBJ)/.xrandr-build $(XRANDR_DIST): CCACHE_BASEDIR = $(XRANDR_SRC)
+
+$(OBJ)/.xrandr-configure: $(OBJ)/.xrandr-source
+	rm -rf $(XRANDR_OBJ) $(XRANDR_DST)
+	mkdir -p $(XRANDR_OBJ)
+	cd $(XRANDR_OBJ) && env $(XRANDR_ENV) $(XRANDR_SRC)/configure $(--quiet?) -C \
+	    --prefix="$(XRANDR_DST)" \
+	    --bindir="$(XRANDR_DST)/bin" \
+	    --host="$($(XRANDR_ARCH)-unix_TARGET)"
+	touch $@
+
+$(OBJ)/.xrandr-build: $(OBJ)/.xrandr-configure
+	cd $(XRANDR_OBJ) && env $(XRANDR_ENV) $(MAKE)
+	cd $(XRANDR_OBJ) && env $(XRANDR_ENV) $(MAKE) install
+	touch $@
+
+$(XRANDR_DIST): $(OBJ)/.xrandr-build | $(DST_DIR)
+	mkdir -p $(XRANDR_BINDIR)
+	$(call install-strip,$(XRANDR_DST)/bin/xrandr,$(XRANDR_BINDIR))
+
+all-dist: $(XRANDR_DIST)
+
+
